{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noLabelWithoutControl": "error",
				"noNoninteractiveElementInteractions": "error",
				"noSvgWithoutTitle": "error",
				"useButtonType": "error",
				"useKeyWithClickEvents": "error",
				"useValidAnchor": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 15
					}
				},
				"noExtraBooleanCast": "error",
				"noUselessStringConcat": "error",
				"noUselessTernary": "error",
				"noUselessUndefined": "error",
				"useDateNow": "error",
				"noUnnecessaryTemplateExpression": "error",
				"useArraySome": "error",
				"useMathMinMax": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedImports": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error",
				"noPlaywrightMissingAwait": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"noNegationInEqualityCheck": "error",
				"noUnsafePlusOperands": "error",
				"noUselessTypeConversion": "error",
				"useExhaustiveSwitchCases": "error",
				"useIncludes": "error",
				"useStringStartsEndsWith": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error"
			},
			"security": {
				"noGlobalEval": "error"
			},
			"style": {
				"noCommonJs": "error",
				"noExportedImports": "error",
				"noInferrableTypes": "error",
				"noNegationElse": "error",
				"noNestedTernary": "error",
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"noSubstr": "error",
				"noUnusedTemplateLiteral": "error",
				"noUselessElse": "error",
				"noYodaExpression": "error",
				"useCollapsedElseIf": "error",
				"useCollapsedIf": "error",
				"useConsistentArrayType": {
					"level": "error",
					"options": {
						"syntax": "shorthand"
					}
				},
				"useConsistentBuiltinInstantiation": "error",
				"useConst": "error",
				"useDefaultParameterLast": "error",
				"useErrorCause": "error",
				"useExplicitLengthCheck": "error",
				"useExponentiationOperator": "error",
				"useExportType": "error",
				"useForOf": "error",
				"useImportType": "error",
				"useNodejsImportProtocol": "error",
				"useNumberNamespace": "error",
				"useObjectSpread": "error",
				"useSelfClosingElements": "error",
				"useShorthandAssign": "error",
				"useSingleVarDeclarator": "error",
				"useTemplate": "error",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error",
				"noPlaywrightWaitForSelector": "error",
				"useImportsFirst": "error"
			},
			"suspicious": {
				"noAlert": "error",
				"noArrayIndexKey": "error",
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["warn", "error", "info"]
					}
				},
				"noDoubleEquals": "error",
				"noEmptyInterface": "error",
				"noEvolvingTypes": "error",
				"noExplicitAny": "error",
				"noExtraNonNullAssertion": "error",
				"noFocusedTests": "error",
				"noMisleadingInstantiator": "error",
				"noNestedPromises": "error",
				"noShadow": "error",
				"noTsIgnore": "error",
				"noUnsafeDeclarationMerging": "error",
				"noUnusedExpressions": "error",
				"noVar": "error",
				"noIdenticalTestTitle": "error",
				"noPlaywrightForceOption": "error",
				"noPlaywrightNetworkidle": "error",
				"noPlaywrightPagePause": "error",
				"noPlaywrightWaitForTimeout": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["scripts/**", "**/scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.cjs", "**/*.config.js", "**/*.config.cjs"],
			"linter": {
				"rules": {
					"style": {
						"noCommonJs": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all",
			"lineWidth": 120,
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true,
			"bracketSameLine": true
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
